{
  "schema": "sks.profile/1",
  "id": "arkit",
  "name": "ARKit 52",
  "description": "Apple ARKit 52 个标准形态键，另加常见的左右拆分版（BrowInnerUpLeft/Right、CheekPuffLeft/Right）和虹膜平面移动（Look*）。",
  "aliases": [ "unified_expressions", "sranipal" ],
  "channels": [
    { "name": "browDownLeft",       "group": "brow", "sum": [ { "s": "browDown.L" }, { "s": "browBring.L", "k": 0.5 } ] },
    { "name": "browDownRight",      "group": "brow", "sum": [ { "s": "browDown.R" }, { "s": "browBring.R", "k": 0.5 } ] },
    { "name": "browInnerUp",        "group": "brow", "sum": [ { "s": "browInnerUp.L", "k": 0.5 }, { "s": "browInnerUp.R", "k": 0.5 } ] },
    { "name": "BrowInnerUpLeft",    "group": "brow", "s": "browInnerUp.L", "extension": true },
    { "name": "BrowInnerUpRight",   "group": "brow", "s": "browInnerUp.R", "extension": true },
    { "name": "browOuterUpLeft",    "group": "brow", "s": "browOuterUp.L" },
    { "name": "browOuterUpRight",   "group": "brow", "s": "browOuterUp.R" },

    { "name": "eyeBlinkLeft",       "group": "eye", "s": "blink.L" },
    { "name": "eyeBlinkRight",      "group": "eye", "s": "blink.R" },
    { "name": "eyeWideLeft",        "group": "eye", "s": "eyeWide.L" },
    { "name": "eyeWideRight",       "group": "eye", "s": "eyeWide.R" },
    { "name": "eyeSquintLeft",      "group": "eye", "s": "eyeSquint.L" },
    { "name": "eyeSquintRight",     "group": "eye", "s": "eyeSquint.R" },

    { "name": "eyeLookUpLeft",      "group": "gaze", "gaze_set": "eye_look", "eye": "L", "axis": "pitch", "sign": 1 },
    { "name": "eyeLookDownLeft",    "group": "gaze", "gaze_set": "eye_look", "eye": "L", "axis": "pitch", "sign": -1 },
    { "name": "eyeLookInLeft",      "group": "gaze", "gaze_set": "eye_look", "eye": "L", "axis": "yaw",   "sign": 1 },
    { "name": "eyeLookOutLeft",     "group": "gaze", "gaze_set": "eye_look", "eye": "L", "axis": "yaw",   "sign": -1 },
    { "name": "eyeLookUpRight",     "group": "gaze", "gaze_set": "eye_look", "eye": "R", "axis": "pitch", "sign": 1 },
    { "name": "eyeLookDownRight",   "group": "gaze", "gaze_set": "eye_look", "eye": "R", "axis": "pitch", "sign": -1 },
    { "name": "eyeLookInRight",     "group": "gaze", "gaze_set": "eye_look", "eye": "R", "axis": "yaw",   "sign": -1 },
    { "name": "eyeLookOutRight",    "group": "gaze", "gaze_set": "eye_look", "eye": "R", "axis": "yaw",   "sign": 1 },
    { "name": "LookUpLeft",         "group": "gaze", "gaze_set": "look", "eye": "L", "axis": "pitch", "sign": 1,  "extension": true },
    { "name": "LookDownLeft",       "group": "gaze", "gaze_set": "look", "eye": "L", "axis": "pitch", "sign": -1, "extension": true },
    { "name": "LookInLeft",         "group": "gaze", "gaze_set": "look", "eye": "L", "axis": "yaw",   "sign": 1,  "extension": true },
    { "name": "LookOutLeft",        "group": "gaze", "gaze_set": "look", "eye": "L", "axis": "yaw",   "sign": -1, "extension": true },
    { "name": "LookUpRight",        "group": "gaze", "gaze_set": "look", "eye": "R", "axis": "pitch", "sign": 1,  "extension": true },
    { "name": "LookDownRight",      "group": "gaze", "gaze_set": "look", "eye": "R", "axis": "pitch", "sign": -1, "extension": true },
    { "name": "LookInRight",        "group": "gaze", "gaze_set": "look", "eye": "R", "axis": "yaw",   "sign": -1, "extension": true },
    { "name": "LookOutRight",       "group": "gaze", "gaze_set": "look", "eye": "R", "axis": "yaw",   "sign": 1,  "extension": true },

    { "name": "noseSneerLeft",      "group": "nose_cheek", "s": "sneer.L" },
    { "name": "noseSneerRight",     "group": "nose_cheek", "s": "sneer.R" },
    { "name": "cheekSquintLeft",    "group": "nose_cheek", "s": "cheekSquint.L" },
    { "name": "cheekSquintRight",   "group": "nose_cheek", "s": "cheekSquint.R" },
    { "name": "cheekPuff",          "group": "nose_cheek", "sum": [ { "s": "puff.L", "k": 0.5 }, { "s": "puff.R", "k": 0.5 } ] },
    { "name": "CheekPuffLeft",      "group": "nose_cheek", "s": "puff.L", "extension": true },
    { "name": "CheekPuffRight",     "group": "nose_cheek", "s": "puff.R", "extension": true },

    { "name": "mouthSmileLeft",     "group": "mouth", "sum": [ { "s": "smile.L" }, { "s": "smileMinor.L", "k": 0.5 } ] },
    { "name": "mouthSmileRight",    "group": "mouth", "sum": [ { "s": "smile.R" }, { "s": "smileMinor.R", "k": 0.5 } ] },
    { "name": "mouthFrownLeft",     "group": "mouth", "s": "frown.L" },
    { "name": "mouthFrownRight",    "group": "mouth", "s": "frown.R" },
    { "name": "mouthDimpleLeft",    "group": "mouth", "s": "dimple.L" },
    { "name": "mouthDimpleRight",   "group": "mouth", "s": "dimple.R" },
    { "name": "mouthStretchLeft",   "group": "mouth", "s": "stretch.L" },
    { "name": "mouthStretchRight",  "group": "mouth", "s": "stretch.R" },
    { "name": "mouthPressLeft",     "group": "mouth", "s": "press.L" },
    { "name": "mouthPressRight",    "group": "mouth", "s": "press.R" },
    { "name": "mouthUpperUpLeft",   "group": "mouth", "s": "upperLipUp.L" },
    { "name": "mouthUpperUpRight",  "group": "mouth", "s": "upperLipUp.R" },
    { "name": "mouthLowerDownLeft", "group": "mouth", "s": "lowerLipDown.L" },
    { "name": "mouthLowerDownRight","group": "mouth", "s": "lowerLipDown.R" },
    { "name": "mouthFunnel",        "group": "mouth", "sum": [ { "s": "funnel.L", "k": 0.5 }, { "s": "funnel.R", "k": 0.5 } ] },
    { "name": "mouthPucker",        "group": "mouth", "sum": [ { "s": "funnelTogether.L", "k": 0.5 }, { "s": "funnelTogether.R", "k": 0.5 } ] },
    { "name": "mouthLeft",          "group": "mouth", "s": "mouthMove.left" },
    { "name": "mouthRight",         "group": "mouth", "s": "mouthMove.right" },
    { "name": "mouthShrugUpper",    "group": "mouth", "s": "mouthMove.up" },
    { "name": "mouthShrugLower",    "group": "mouth", "s": "chinRaise" },
    { "name": "mouthRollUpper",     "group": "mouth", "s": "upperLipRoll" },
    { "name": "mouthRollLower",     "group": "mouth", "s": "lowerLipRoll" },
    { "name": "mouthClose",         "group": "mouth", "sum": [ { "s": "lipsTogether.L", "k": 0.5 }, { "s": "lipsTogether.R", "k": 0.5 } ] },

    { "name": "jawOpen",            "group": "jaw", "s": "jawOpen" },
    { "name": "jawForward",         "group": "jaw", "note": "游戏里没有对应信号" },
    { "name": "jawLeft",            "group": "jaw", "note": "游戏里没有对应信号（fcParam 053-056 可能是下巴横移，待实测）" },
    { "name": "jawRight",           "group": "jaw", "note": "游戏里没有对应信号" },

    { "name": "tongueOut",          "group": "tongue", "note": "游戏里没有舌头信号" }
  ]
}
