{
  "schema": "sks.profile/1",
  "id": "mmd",
  "name": "MMD",
  "description": "PMX 模型的通用表情（保下限）：上眼皮、嘴角、张嘴、横拉、收窄、眉。每个通道按 any 列表找 mesh 上第一个存在的名字；全角/半角、大小写、空格不区分。选错的键可以另存一份 extends mmd 的配置，改 any 顺序后绑定到这个部件。",
  "aliases": [],
  "channels": [
    { "name": "ウィンク２", "group": "eye", "s": "blink.L",
      "any": ["ウインク２", "ウィンク２左", "ウィンク左２", "ウィンク", "ウインク", "ウィンク左", "wink2", "wink"],
      "note": "左眼闭眼（模型自己的左侧）。没有 ウィンク２ 时用 ウィンク（部分模型是笑眼形状，仍然会闭眼）" },
    { "name": "ｳｨﾝｸ２右", "group": "eye", "s": "blink.R",
      "any": ["ウインク２右", "ウィンク右２", "ウインク右２", "ウィンク２R", "ウィンク右", "ウインク右", "wink2_r", "wink_r"],
      "note": "右眼闭眼" },
    { "name": "まばたき", "group": "eye", "sum": [ { "s": "blink.L", "k": 0.5 }, { "s": "blink.R", "k": 0.5 } ],
      "any": ["瞬き", "blink", "眨眼", "闭眼", "目閉じ"],
      "unless": ["ウィンク２", "ｳｨﾝｸ２右"],
      "note": "双眼闭眼，只在没有左右 wink 键时使用" },
    { "name": "びっくり", "group": "eye", "sum": [ { "s": "eyeWide.L", "k": 0.5 }, { "s": "eyeWide.R", "k": 0.5 } ],
      "any": ["見開き", "驚き", "surprised"],
      "note": "睁大眼" },
    { "name": "じと目", "group": "eye",
      "mul": [ { "sum": [ { "s": "eyeSquint.L", "k": 0.5 }, { "s": "eyeSquint.R", "k": 0.5 } ] },
               { "sub": [ { "const": 1 }, { "sum": [ { "s": "blink.L", "k": 0.5 }, { "s": "blink.R", "k": 0.5 } ] } ] } ],
      "any": ["ジト目", "半目"],
      "note": "上眼皮半闭；闭眼时自动减弱，避免和闭眼叠加压穿" },
    { "name": "下瞼上げ", "group": "eye",
      "mul": [ { "sum": [ { "s": "cheekSquint.L", "k": 0.5 }, { "s": "cheekSquint.R", "k": 0.5 } ] },
               { "sub": [ { "const": 1 }, { "sum": [ { "s": "blink.L", "k": 0.5 }, { "s": "blink.R", "k": 0.5 } ] } ] } ],
      "any": ["下眼上", "下まつ毛上げ", "下まぶた上げ", "下眼睑上"],
      "note": "下眼皮上抬（附加，多数模型没有）" },

    { "name": "あ", "group": "mouth", "s": "jawOpen", "any": ["ア"], "note": "张嘴" },
    { "name": "う", "group": "mouth", "sum": [ { "s": "funnel.L", "k": 0.5 }, { "s": "funnel.R", "k": 0.5 } ],
      "any": ["ウ"], "note": "嘟嘴" },
    { "name": "口角上げ", "group": "mouth", "max": [ { "s": "smile.L" }, { "s": "smile.R" } ],
      "any": ["口角上", "にこり口", "微笑", "にやり"],
      "unless": ["口角上げ左", "口角上げ右"],
      "note": "嘴角上扬（对称键，没有左右版时使用）" },
    { "name": "口角上げ左", "group": "mouth", "s": "smile.L", "any": ["口角上左", "左口角上げ"] },
    { "name": "口角上げ右", "group": "mouth", "s": "smile.R", "any": ["口角上右", "右口角上げ"] },
    { "name": "口角下げ", "group": "mouth", "max": [ { "s": "frown.L" }, { "s": "frown.R" } ],
      "any": ["口角下", "への字", "∧"],
      "unless": ["口角下げ左", "口角下げ右"],
      "note": "嘴角下撇（对称键，没有左右版时使用）" },
    { "name": "口角下げ左", "group": "mouth", "s": "frown.L", "any": ["口角下左", "左口角下げ"] },
    { "name": "口角下げ右", "group": "mouth", "s": "frown.R", "any": ["口角下右", "右口角下げ"] },
    { "name": "口横広げ", "group": "mouth", "sum": [ { "s": "stretch.L", "k": 0.5 }, { "s": "stretch.R", "k": 0.5 } ],
      "any": ["口横広げる", "口横伸ばし", "口横広"], "note": "嘴横拉" },
    { "name": "口横狭く", "group": "mouth", "sum": [ { "s": "funnelTogether.L", "k": 0.5 }, { "s": "funnelTogether.R", "k": 0.5 } ],
      "any": ["口横狭め", "口横缩げ", "口横縮め", "口すぼめ", "口横狭"], "note": "嘴收窄" },
    { "name": "口上", "group": "mouth", "sum": [ { "s": "upperLipUp.L", "k": 0.5 }, { "s": "upperLipUp.R", "k": 0.5 } ],
      "any": ["上唇上げ"], "note": "上唇上提（附加）" },
    { "name": "口下", "group": "mouth", "sum": [ { "s": "lowerLipDown.L", "k": 0.5 }, { "s": "lowerLipDown.R", "k": 0.5 } ],
      "any": ["下唇下げ"], "note": "下唇下拉（附加）" },

    { "name": "上", "group": "brow", "sum": [ { "s": "browOuterUp.L", "k": 0.5 }, { "s": "browOuterUp.R", "k": 0.5 } ],
      "any": ["眉上", "眉上げ"], "note": "眉上" },
    { "name": "下", "group": "brow", "sum": [ { "s": "browDown.L", "k": 0.5 }, { "s": "browDown.R", "k": 0.5 } ],
      "any": ["眉下", "眉下げ", "真面目"], "note": "眉下" },
    { "name": "困る", "group": "brow", "sum": [ { "s": "browInnerUp.L", "k": 0.5 }, { "s": "browInnerUp.R", "k": 0.5 } ],
      "any": ["困り", "眉困り"], "note": "眉心上提" },
    { "name": "怒り", "group": "brow", "sum": [ { "s": "browBring.L", "k": 0.5 }, { "s": "browBring.R", "k": 0.5 } ],
      "any": ["眉怒り"], "note": "皱眉（部分模型的 怒り 也会动眼睛）" }
  ]
}
